{
  "name": "julieedwards-info",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "preview": "npm run build && vite preview",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "test": "node --test test/",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply julieedwards --local",
    "db:migrate:prod": "wrangler d1 migrations apply julieedwards --remote"
  },
  "dependencies": {
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.4.0",
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.5.1",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.7.2",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.9.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
    "drizzle-orm": "0.45.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.9.0",
    "@react-router/dev": "8.3.1",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "wrangler": "4.130.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
