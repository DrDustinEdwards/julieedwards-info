{
  "name": "julieedwards-info",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run headers && react-router build",
    "dev": "npm run headers && react-router dev",
    "headers": "site-runtime-headers --site julieedwards-info --out public/_headers --header \"tdm-reservation: 1\"",
    "preview": "npm run build && vite preview",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "test": "node --test \"test/*.test.ts\"",
    "check:console": "devkit-console",
    "check:migrations": "devkit-migrations drizzle",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply julieedwards --local",
    "db:migrate:prod": "wrangler d1 migrations apply julieedwards --remote",
    "bloat": "devkit-no-bloat",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.63.3",
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.16.3",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.46.1",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.173.12",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.163.1",
    "drizzle-orm": "0.45.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.56.0",
    "@react-router/dev": "8.5.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "hast-util-to-mdast": "10.1.3",
    "hast-util-to-string": "3.0.1",
    "hastscript": "9.0.3",
    "htmlparser2": "12.0.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.2.3",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.164.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
