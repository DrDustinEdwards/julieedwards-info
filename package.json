{
  "name": "julieedwards-info",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run headers && react-router build",
    "dev": "npm run headers && react-router dev",
    "headers": "site-runtime-headers --site julieedwards-info --out public/_headers --header \"tdm-reservation: 1\"",
    "preview": "npm run build && vite preview",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "test": "node --test \"test/*.test.ts\"",
    "check:console": "devkit-console",
    "check:migrations": "devkit-migrations drizzle",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply julieedwards --local",
    "db:migrate:prod": "wrangler d1 migrations apply julieedwards --remote",
    "bloat": "devkit-no-bloat"
  },
  "dependencies": {
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.30.1",
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.8.0",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.21.0",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.65.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.53.0",
    "drizzle-orm": "0.45.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.21.0",
    "@react-router/dev": "8.5.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.156.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
