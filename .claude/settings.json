{
  "permissions": {
    "allow": ["Bash(git:*)", "Bash(gh:*)", "Bash(npm:*)", "Bash(npx tsc:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-em-dash.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/scoped-git-add.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash -c 'set -o pipefail; cd \"$(git rev-parse --show-toplevel)\" && npx tsc --noEmit 2>&1 | tail -20'" }
        ]
      }
    ]
  }
}
