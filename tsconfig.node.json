{
  "extends": "./tsconfig.json",
  "include": ["vite.config.ts", "react-router.config.ts", "test/**/*", "app/lib/source.ts", "workers/header-set.ts", "scripts/**/*"],
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  }
}
