// Copy to wrangler.jsonc (gitignored: this repository is public) and put the D1 database's id in place
// of <D1_DATABASE_ID>. CI's deploy job writes it the same way from the repository variable D1_DATABASE_ID.
// Secrets are set with `wrangler secret put`, never here: CARREL_SITE_KEY (Carrel's key for this site) and, optionally,
// AI_GATEWAY_BASE_URL (the AI Gateway the media suggestions run through; it carries the account id).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "julieedwards",
	"main": "./workers/app.ts",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1 }
	},
	"upload_source_maps": true,
	// The page's edge cache (workers/app.ts). The default export is the GATEWAY, cache disabled, so it runs on every
	// request (the CSP report receiver, /media and Carrel's API). It calls the Renderer through ctx.exports with the path
	// as the cache key, and the Renderer's responses are stored. Only a response a route marks shared
	// (app/lib/edge-cache.server.ts) is kept; the rest are sent no-store. Carrel's writes purge the tag. No
	// `cross_version_cache`, so the Worker version stays in the key and every deploy starts cold.
	"cache": { "enabled": true },
	"exports": {
		"default": { "type": "worker", "cache": { "enabled": false } },
		"Renderer": { "type": "worker", "cache": { "enabled": true } }
	},
	// The site's copy (app/lib/source.ts), seeded by drizzle/0001_seed.sql.
	"d1_databases": [
		{ "binding": "DB", "database_name": "julieedwards", "database_id": "<D1_DATABASE_ID>", "migrations_dir": "drizzle" }
	],
	// BACKUPS: nightly D1 dumps (d1-dump, app/lib/backup.server.ts). MEDIA: the media library Carrel uploads to
	// (app/lib/media), each file under uploads/ and served at /media/<key>, with the earlier bytes of a replaced or
	// turned file under history/, which is never served. Both buckets must exist before the deploy that names them.
	"r2_buckets": [
		{ "binding": "BACKUPS", "bucket_name": "julieedwards-backups" },
		{ "binding": "MEDIA", "bucket_name": "julieedwards-media" }
	],
	// Cloudflare Images: each library picture's sizes for the page (site-runtime ./image, /media/<key>?w=), and the
	// turns, mirrors and shrinks an editor asks for in Carrel. Carries no id.
	"images": { "binding": "IMAGES" },
	// Workers AI, for suggested tags and alt text when an editor asks for them in Carrel (app/lib/media/suggest.server.ts),
	// never on a visitor's request and never applied unasked. Through AI Gateway when the secret AI_GATEWAY_BASE_URL
	// names one. Carries no id.
	"ai": { "binding": "AI" },
	// Carrel's site API (app/lib/carrel). namespace_id is this site's own: sites sharing one share counters.
	"ratelimits": [
		{ "name": "CARREL_RATE_LIMIT", "namespace_id": "7501", "simple": { "limit": 120, "period": 60 } },
		// CSP violation reports (/csp-report), per address. Loose, because a page tripping ten rules sends ten.
		{ "name": "CSP_REPORT_RATE_LIMIT", "namespace_id": "7502", "simple": { "limit": 60, "period": 60 } }
	],
	// 03:37 UTC nightly: runBackup().
	"triggers": { "crons": ["37 3 * * *"] }
}
